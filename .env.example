# Prioridade: institucional; se indisponivel, NVIDIA.
# O institucional so e ativado quando BASE_URL e MODEL sao preenchidos.
# O endpoint deve ser compativel com OpenAI Chat Completions.
INSTITUTIONAL_BASE_URL=
INSTITUTIONAL_MODEL=
INSTITUTIONAL_API_KEY=

# NVIDIA NIM - endpoint hospedado (nao requer GPU local)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_KEY=
